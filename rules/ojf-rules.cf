# outlook-junk-filter: extra SpamAssassin rules, shipped in the image. They are installed next to the stock rules
# (as 99_ojf.cf), so they load before /config/local.cf, which can override any score here.
#
# Erectile-dysfunction spam that avoids drug names. It describes the effect ("rock-hard for hours", "blood flow",
# "no prescriptions") instead of naming a pill, so the stock pharmacy rules never fire. Two of the three groups below
# must match; any one alone (a health newsletter that says "blood flow") scores nothing.

header   __OJF_ED_SUBJ   Subject =~ /\b(?:rock[- ]?(?:hard|solid)|no prescriptions?|male enhancement|potency|stay(?:ing)? hard|blue pills?|bedroom performance)\b/i
body     __OJF_ED_ACT    /\b(?:rock[- ]?(?:hard|solid)|rigid|firmness|go(?:ing)? soft|sudden softness|weak blood flow|bedroom performance|last(?:ing)? for hours)\b/i
body     __OJF_ED_PITCH  /\b(?:(?:prescription )?(?:blue )?pills?\b.{0,80}\b(?:side effects?|headaches?|dependency)|no (?:dangerous )?side effects?|no prescriptions?|blood flow|leaked (?:clinical )?(?:report|study)|(?:morning )?(?:baking soda|recipe) (?:trick|secret))\b/i

meta     OJF_ED_SPAM     (__OJF_ED_SUBJ + __OJF_ED_ACT + __OJF_ED_PITCH) >= 2
describe OJF_ED_SPAM     Erectile-dysfunction pitch without naming a drug
score    OJF_ED_SPAM     3.0

# Weight-loss and GLP-1 advertising. A topic alone is not spam (health newsletters exist), so this counts only when
# Microsoft's own filter already rated the message 5 or higher (the SCL header is part of the message text SpamAssassin sees).
header   __OJF_MS_SCL_5UP  X-MS-Exchange-Organization-SCL =~ /^\s*[5-9]\s*$/
header   __OJF_WL_SUBJ     Subject =~ /\b(?:GLP-?1|semaglutide|tirzepatide|ozempic|wegovy|mounjaro|zepbound|weight[- ]loss)\b/i
body     __OJF_WL_BODY     /\b(?:GLP-?1|semaglutide|tirzepatide|ozempic|wegovy|mounjaro|zepbound|(?:medical )?weight[- ]loss (?:journey|program|plan|medication|support)|lose \d+ (?:lbs|pounds))\b/i

meta     OJF_WEIGHTLOSS_AD __OJF_MS_SCL_5UP && (__OJF_WL_SUBJ || __OJF_WL_BODY)
describe OJF_WEIGHTLOSS_AD Weight-loss or GLP-1 advertising that Microsoft already rated as spam
score    OJF_WEIGHTLOSS_AD 2.5

# Microsoft already filed it as junk (SCL 5 or higher) AND the message admits it is an advertisement (stock rule
# ADMITS_SPAM, "this is an advertisement"). Independent of topic and subject, so it also covers the next campaign.
meta     OJF_JUNK_ADMITS_SPAM __OJF_MS_SCL_5UP && ADMITS_SPAM
describe OJF_JUNK_ADMITS_SPAM Microsoft rated it junk and it admits to being an advertisement
score    OJF_JUNK_ADMITS_SPAM 1.5
